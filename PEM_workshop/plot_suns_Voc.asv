function plot_suns_Voc(illuminations, Vocs, par)

coeffs = polyfit(log10(illuminations), Vocs, 1);
display(['m = ' num2str(coeffs(1)/(par.kB*par.T))])

figure('Name', 'SunsVoc')

hold on
plot(log10(illuminations), Vocs, 'Marker', 'o', 'LineStyle', 'none', 'Label', 'data')
plot(log10(illuminations), coeffs(2'Label', 'Fit')

xlim([log10(illuminations(10)), log10(illuminations(end))])
xlabel('log_{10}(\phi)')
ylabel('V_{OC}')